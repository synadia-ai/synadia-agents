{
  "name": "claude-channel-nats",
  "version": "0.5.1",
  "description": "Synadia Agent Protocol for NATS channel for Claude Code. Exposes a Claude Code session as a discoverable, spec-compliant agent on NATS via an MCP server.",
  "author": "Synadia Communications",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synadia-ai/synadia-agents.git",
    "directory": "agents/claude-code"
  },
  "homepage": "https://github.com/synadia-ai/synadia-agents/tree/main/agents/claude-code",
  "bugs": {
    "url": "https://github.com/synadia-ai/synadia-agents/issues"
  },
  "type": "module",
  "bin": "./runtime/server.js",
  "scripts": {
    "build": "bun ./scripts/build-runtime.ts",
    "start": "bun ./runtime/server.js",
    "test": "bun test ./test && bun ./scripts/roundtrip-test.ts && bun ./scripts/identity-roundtrip-test.ts",
    "typecheck": "tsc --noEmit",
    "verify:bundle": "bun ./scripts/verify-bundle.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nats-io/transport-node": "3.4.0",
    "@synadia-ai/agent-service": "file:../../agent-sdk/typescript",
    "@synadia-ai/agents": "file:../../client-sdk/typescript",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "typescript": "5.9.3"
  }
}
